{
    "name": "@tronweb3/tronwallet-adapter-tronlink-evm",
    "version": "1.1.1",
    "description": "Wallet adapter for TronLink wallet extension.",
    "keywords": [
        "EVM",
        "Ethereum Wallet",
        "TronLink wallet"
    ],
    "author": "tronweb3",
    "repository": {
        "type": "git",
        "url": "https://github.com/tronweb3/tronwallet-adapter"
    },
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=16",
        "pnpm": ">=7"
    },
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        "require": "./lib/cjs/index.js",
        "import": "./lib/esm/index.js",
        "types": "./lib/types/index.d.ts"
    },
    "files": [
        "lib",
        "src",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx mkdir -p lib && shx rm -rf lib",
        "package": "shx echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "build:umd": "node ../../../../scripts/build-umd.js",
        "e2e:setup": "node ../e2e-shared/e2e-setup.mjs tronlink",
        "e2e:page": "vite --configLoader runner --config e2e/vite.config.ts",
        "e2e": "playwright test -c e2e/playwright.config.ts"
    },
    "dependencies": {
        "@tronweb3/abstract-adapter-evm": "workspace:^"
    },
    "devDependencies": {
        "@playwright/test": "1.49.1",
        "@testing-library/dom": "8.20.1",
        "@tronweb3/evm-adapter-e2e-shared": "workspace:^",
        "shx": "0.3.4",
        "vite": "6.4.2",
        "vitest": "3.2.4"
    }
}
